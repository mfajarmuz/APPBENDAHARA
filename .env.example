# ============================================================
# BENDAHARA APP - Environment Variables (EXAMPLE)
# ============================================================
# Copy file ini menjadi .env dan isi dengan credential Supabase Anda.
# File .env TIDAK boleh di-commit ke GitHub.
# ============================================================

# Supabase Project URL
# Ambil dari: https://app.supabase.com → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key
# Ambil dari: https://app.supabase.com → Project Settings → API → anon/public key
SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here
